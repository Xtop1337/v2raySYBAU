<Application x:Class="V2RaySybau.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="UI/MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <SolidColorBrush x:Key="Accent" Color="#2563EB"/>
      <SolidColorBrush x:Key="AccentGreen" Color="#4CAF50"/>
      <SolidColorBrush x:Key="AccentRed" Color="#F44336"/>
      <SolidColorBrush x:Key="AccentBlue" Color="#2196F3"/>
      <SolidColorBrush x:Key="BackgroundLight" Color="#F0F0F0"/>
      <SolidColorBrush x:Key="BorderColor" Color="#CCCCCC"/>
    </ResourceDictionary>
  </Application.Resources>
</Application>
