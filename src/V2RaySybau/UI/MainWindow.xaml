<Window x:Class="V2RaySybau.UI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="V2Ray Sybau" Width="1200" Height="700" Background="#F0F0F0">
  <Grid Margin="18">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="320"/>
      <ColumnDefinition Width="12"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Left Panel: Profile List and Controls -->
    <DockPanel Grid.Column="0">
      <StackPanel DockPanel.Dock="Top">
        <TextBlock Text="Профили" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>
        
        <WrapPanel Margin="0,0,0,12" Height="Auto">
          <Button Content="Импорт" Click="Import_Click" Padding="16,6" Margin="0,0,6,0" Background="#4CAF50" Foreground="White"/>
          <Button Content="Экспорт" Click="Export_Click" Padding="16,6" Margin="0,0,6,0" Background="#2196F3" Foreground="White"/>
          <Button Content="Удалить" Click="Delete_Click" Padding="16,6" Background="#F44336" Foreground="White"/>
        </WrapPanel>

        <ComboBox x:Name="GroupFilter" SelectionChanged="GroupFilter_SelectionChanged" Margin="0,0,0,8" Padding="8,6"/>
      </StackPanel>

      <ListBox x:Name="Profiles" DockPanel.Dock="Top" SelectionChanged="Profiles_SelectionChanged" Margin="0,12,0,0" Padding="8" Background="White" BorderThickness="1" BorderBrush="#CCCCCC"/>
    </DockPanel>

    <!-- Right Panel: Main Content -->
    <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="200"/>
      </Grid.RowDefinitions>

      <!-- Top: Connection Controls -->
      <StackPanel Grid.Row="0" Margin="0,0,0,18">
        <StackPanel Orientation="Horizontal">
          <Button x:Name="ConnectButton" Content="Подключить" Click="Connect_Click" Padding="24,12" FontSize="14" FontWeight="SemiBold" Background="#4CAF50" Foreground="White" MinWidth="120"/>
          <CheckBox x:Name="SystemProxy" Content="Системный прокси" Margin="24,0,0,0" VerticalAlignment="Center" Changed="SystemProxy_Changed"/>
        </StackPanel>
      </StackPanel>

      <!-- Middle: Profile Editor -->
      <Grid Grid.Row="1" Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="120"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Имя:" VerticalAlignment="Center" Margin="0,0,12,8"/>
        <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Padding="8" Margin="0,0,0,8" Background="White" BorderThickness="1" BorderBrush="#CCCCCC"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Host:" VerticalAlignment="Center" Margin="0,0,12,8"/>
        <TextBox x:Name="HostBox" Grid.Row="1" Grid.Column="1" Padding="8" Margin="0,0,0,8" Background="White" BorderThickness="1" BorderBrush="#CCCCCC"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Port:" VerticalAlignment="Center" Margin="0,0,12,8"/>
        <TextBox x:Name="PortBox" Grid.Row="2" Grid.Column="1" Padding="8" Margin="0,0,0,8" Background="White" BorderThickness="1" BorderBrush="#CCCCCC"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="User ID:" VerticalAlignment="Center" Margin="0,0,12,8"/>
        <TextBox x:Name="UserIdBox" Grid.Row="3" Grid.Column="1" Padding="8" Margin="0,0,0,8" Background="White" BorderThickness="1" BorderBrush="#CCCCCC"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Группа:" VerticalAlignment="Center" Margin="0,0,12,8"/>
        <TextBox x:Name="GroupBox" Grid.Row="4" Grid.Column="1" Padding="8" Margin="0,0,0,8" Background="White" BorderThickness="1" BorderBrush="#CCCCCC"/>

        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,12,0,0">
          <Button Content="Сохранить" Click="SaveEditor" Padding="16,8" Margin="0,0,6,0" Background="#2196F3" Foreground="White"/>
          <CheckBox x:Name="AutoConnect" Content="Автоподключение" Margin="12,0,0,0" VerticalAlignment="Center"/>
          <CheckBox x:Name="Autostart" Content="Запуск с системой" Margin="12,0,0,0" VerticalAlignment="Center" Changed="Autostart_Changed"/>
          <ComboBox x:Name="Theme" SelectionChanged="Theme_SelectionChanged" Margin="12,0,0,0" Width="120">
            <ComboBoxItem>System</ComboBoxItem>
            <ComboBoxItem>Light</ComboBoxItem>
            <ComboBoxItem>Dark</ComboBoxItem>
          </ComboBox>
        </StackPanel>
      </Grid>

      <!-- Bottom: Event Log -->
      <GroupBox Grid.Row="2" Header="Журнал подключения" Padding="8">
        <ListBox x:Name="Log" FontFamily="Consolas" FontSize="11" Background="White" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock>
                <TextBlock.Inlines>
                  <Run Text="{Binding At, StringFormat='[HH:mm:ss]'}" Foreground="#999999"/>
                  <Run Text=" "/>
                  <Run Text="{Binding Level}" Foreground="#0066CC" FontWeight="SemiBold"/>
                  <Run Text=": "/>
                  <Run Text="{Binding Message}"/>
                </TextBlock.Inlines>
              </TextBlock>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </GroupBox>
    </Grid>
  </Grid>
</Window>
