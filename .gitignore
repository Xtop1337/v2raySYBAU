/target
node_modules/
/dist/
/src-tauri/gen/
/src-tauri/resources/cores/*
!/src-tauri/resources/cores/.gitkeep
# Generated with the cores (scripts/fetch-cores.ps1, scripts/third_party_licenses.py); the
# standard license texts in that folder are committed.
/src-tauri/resources/licenses/SOURCES.txt
/src-tauri/resources/licenses/sources.json
/src-tauri/resources/licenses/THIRD-PARTY-NOTICES.md
/src-tauri/resources/licenses/THIRD-PARTY-DEPENDENCIES.txt
/src-tauri/resources/licenses/*.LICENSE.txt
*.tmp
